# Cilj za /api proxy v Vite dev strežniku
# - lokalno (npm run dev): http://localhost:3000
# - znotraj docker-compose: http://web-service:3000
VITE_API_PROXY=http://localhost:3000

# WebSocket URL (Socket.io)
# - lokalno: http://localhost:3000
# - v produkciji ali za VM: pustite prazno (frontend uporabi trenutno origin)
VITE_SOCKET_URL=
