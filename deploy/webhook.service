[Unit]
Description=VirtualEstate deploy webhook listener
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=VirtualEstate
Group=docker
WorkingDirectory=/home/VirtualEstate/VirtualEstate_Project
ExecStart=/usr/bin/webhook \
    -hooks /home/VirtualEstate/VirtualEstate_Project/deploy/hooks.json \
    -port 9000 \
    -verbose
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
