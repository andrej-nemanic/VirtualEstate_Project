<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Administrativni nadzorni center</h2>
        <a href="/dashboard" class="btn btn-outline-secondary">Nazaj na Dashboard</a>
    </div>
    <p class="text-muted">Upravljanje s podatkovnimi viri, dodajanje lokacij in nepremičnin v realnem času.</p>
    <hr>

    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">1. Ustvari novo lokacijo</h5>
                </div>
                <div class="card-body">
                    <form id="locationForm">
                        <div class="mb-3">
                            <label class="form-label">Naslov</label>
                            <input type="text" id="locAddress" class="form-control" placeholder="Tržaška cesta 2" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mesto</label>
                            <input type="text" id="locCity" class="form-control" placeholder="Ljubljana" required>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Dolžina (Lng)</label>
                                <input type="number" step="any" id="locLng" class="form-control" placeholder="14.5058" required>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Širina (Lat)</label>
                                <input type="number" step="any" id="locLat" class="form-control" placeholder="46.0569" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Shrani Geografsko Lokacijo</button>
                    </form>
                    <div id="locMessage" class="mt-2 text-success fw-bold"></div>
                </div>
            </div>
        </div>

        <div class="col-md-7 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">2. Objavi nepremičnino</h5>
                </div>
                <div class="card-body">
                    <form id="propertyForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Izberi shranjeno lokacijo</label>
                                <select id="propLocation" class="form-select" required>
                                    <option value="">-- Naložite lokacije --</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tip</label>
                                <select id="propType" class="form-select">
                                    <option value="house">Hiša</option>
                                    <option value="apartment">Stanovanje</option>
                                    <option value="land">Zemljišče</option>
                                    <option value="condominium">Kondominij</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Velikost (m²)</label>
                                <input type="number" id="propSize" class="form-control" required>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Cena (€)</label>
                                <input type="number" id="propPrice" class="form-control" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Opis nepremičnine</label>
                            <textarea id="propDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Dodaj in posodobi Web Sockets</button>
                    </form>
                    <div id="propMessage" class="mt-2 text-success fw-bold"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const token = localStorage.getItem('token');
    
    if (!token) {
        window.location.href = '/login';
    }

    // Dinamično nalaganje vseh lokacij iz baze za izbiralni meni
    function loadLocations() {
        fetch('/locations', {
            headers: { 'Authorization': 'Bearer ' + token }
        })
        .then(res => res.json())
        .then(locations => {
            const select = document.getElementById('propLocation');
            select.innerHTML = '<option value="">-- Izberite lokacijo --</option>';
            locations.forEach(loc => {
                select.innerHTML += `<option value="${loc._id}">${loc.address}, ${loc.city} (${loc.location.coordinates})</option>`;
            });
        });
    }

    // Naložimo ob zagonu strani
    loadLocations();

    // Pošiljanje nove lokacije na strežnik
    document.getElementById('locationForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const data = {
            address: document.getElementById('locAddress').value,
            city: document.getElementById('locCity').value,
            Coordinates: [
                parseFloat(document.getElementById('locLng').value),
                parseFloat(document.getElementById('locLat').value)
            ]
        };

        fetch('/locations', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + token
            },
            body: JSON.stringify(data)
        })
        .then(res => res.json())
        .then(() => {
            document.getElementById('locMessage').innerText = "Lokacija uspešno shranjena v bazo!";
            document.getElementById('locationForm').reset();
            loadLocations(); // Takoj posodobimo spustni meni na desni strani
        })
        .catch(err => console.error(err));
    });

    // Pošiljanje nove nepremičnine
    document.getElementById('propertyForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const data = {
            location: document.getElementById('propLocation').value,
            type: document.getElementById('propType').value,
            size: parseFloat(document.getElementById('propSize').value),
            price: parseFloat(document.getElementById('propPrice').value),
            description: document.getElementById('propDescription').value,
            dateOfPosting: new Date()
        };

        fetch('/properties', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + token
            },
            body: JSON.stringify(data)
        })
        .then(res => {
            if(res.status === 201) {
                document.getElementById('propMessage').innerText = "Nepremičnina uspešno dodana in oddana preko Web Socketov!";
                document.getElementById('propertyForm').reset();
            } else {
                alert("Napaka pri shranjevanju nepremičnine.");
            }
        });
    });
</script>