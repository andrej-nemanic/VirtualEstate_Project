<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h5>Filtriranje podatkov</h5>
                <hr>
                <div class="mb-3">
                    <label>Tip nepremičnine</label>
                    <select id="filterType" class="form-select">
                        <option value="">Vsi tipi</option>
                        <option value="house">Hiša</option>
                        <option value="apartment">Stanovanje</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label>Maksimalna cena: <span id="priceVal">1.000.000</span> €</label>
                    <input type="range" class="form-range" id="filterPrice" min="0" max="1000000" step="10000">
                </div>
                <button class="btn btn-primary w-100" onclick="applyFilters()">Uporabi filtre</button>
            </div>
        </div>

        <div class="col-md-9">
            <div id="map" style="height: 500px; border-radius: 8px;" class="shadow-sm mb-4"></div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="card p-2 shadow-sm">
                        <canvas id="typeChart"></canvas>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card p-2 shadow-sm">
                        <canvas id="priceHistoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
    const socket = io();
    let map = L.map('map').setView([46.0569, 14.5058], 8);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
    
    let propertyMarkers = L.layerGroup().addTo(map);
    let allProperties = [];

    const token = localStorage.getItem('token');
    // Pridobivanje začetnih podatkov
    fetch('/properties', {
        headers: {
            'Authorization': 'Bearer ' + token // Required by authMiddleware
        }
    })
    .then(res => {if (res.status === 401 || res.status === 403) {
            window.location.href = '/login';
        }
        return res.json();
    })
    .then(data => {
        allProperties = data;
        updateUI(allProperties);
    });
    // Realnočasovno posodabljanje preko Socket.io
    socket.on('propertyCreated', (newProperty) => {
        allProperties.push(newProperty);
        updateUI(allProperties);
        alert('Nova nepremičnina dodana v realnem času!');
    });

    function updateUI(data) {
        // Posodobi zemljevid
        propertyMarkers.clearLayers();
        data.forEach(p => {
            if(p.location && p.location.location.coordinates) {
                const coords = p.location.location.coordinates;
                L.marker([coords[1], coords[0]])
                 .bindPopup(`<b>${p.type}</b><br>${p.price} €`)
                 .addTo(propertyMarkers);
            }
        });

        // Posodobi graf (Primer: porazdelitev po tipu)
        updateTypeChart(data);
    }

    function updateTypeChart(data) {
        const counts = data.reduce((acc, p) => {
            acc[p.type] = (acc[p.type] || 0) + 1;
            return acc;
        }, {});

        const ctx = document.getElementById('typeChart').getContext('2d');
        if (window.myChart) window.myChart.destroy();
        window.myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: Object.keys(counts),
                datasets: [{
                    label: 'Število nepremičnin',
                    data: Object.values(counts),
                    backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0']
                }]
            }
        });
    }
</script>