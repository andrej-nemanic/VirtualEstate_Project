<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Pregled nepremičnin v realnem času</h2>
        <a href="/admin" class="btn btn-primary">Administrativni center</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Filtri</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="filterType" class="form-label">Tip nepremičnine:</label>
                    <select id="filterType" class="form-select" onchange="applyFilters()">
                        <option value="">Vse nepremičnine</option>
                        <option value="house">Hiša</option>
                        <option value="apartment">Stanovanje</option>
                        <option value="land">Zemljišče</option>
                        <option value="condominium">Kondominij</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="filterPrice" class="form-label">Maksimalna cena: <span id="priceVal" class="fw-bold text-primary">1.000.000</span> €</label>
                    <input type="range" class="form-range" id="filterPrice" min="0" max="1000000" step="1000" value="1000000" onchange="applyFilters()">
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">Geografski prikaz (Leaflet)</div>
                <div class="card-body p-0">
                    <div id="map" style="height: 500px; width: 100%;"></div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">Statistika</div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <div style="width: 100%; max-width: 300px;">
                        <canvas id="typeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
    // Inicializacija Socket.io odjemalca
    const socket = io();

    // Centriramo zemljevid na Slovenijo 
    let map = L.map('map').setView([46.1512, 14.9955], 8); 
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);
    
    let propertyMarkers = L.layerGroup().addTo(map);
    let allProperties = []; // 

    const priceFilter = document.getElementById('filterPrice'); // 
    const priceVal = document.getElementById('priceVal'); // 

    // Dinamični izpis cene ob premikanju drsnika 
    priceFilter.addEventListener('input', function() {
        priceVal.textContent = Number(this.value).toLocaleString('sl-SI'); // 
    });

    const token = localStorage.getItem('token'); // [cite: 40]
    
    // Pridobivanje začetnih podatkov iz strežnika [cite: 40]
    fetch('/properties', {
        headers: { 'Authorization': 'Bearer ' + token } // [cite: 40]
    })
    .then(res => {
        if (res.status === 401 || res.status === 403) {
            window.location.href = '/login'; // Preusmeritev [cite: 40]
        }
        return res.json();
    })
    .then(data => {
        allProperties = Array.isArray(data) ? data : []; // [cite: 41]
        
        // Prilagoditev drsnika glede na najdražjo nepremičnino [cite: 41]
        if (allProperties.length > 0) {
            const maxPriceInDb = Math.max(...allProperties.map(p => p.price)); // [cite: 41]
            priceFilter.max = maxPriceInDb > 0 ? maxPriceInDb : 1000000; // [cite: 41]
            priceFilter.value = priceFilter.max; // [cite: 42]
            priceVal.textContent = Number(priceFilter.value).toLocaleString('sl-SI'); // [cite: 42]
        }

        updateUI(allProperties); // [cite: 42]
    })
    .catch(err => console.error("Napaka pri pridobivanju podatkov:", err)); // [cite: 42]

    // REALNOČASOVNI SPREJEM PODATKOV (Web Sockets) 
    socket.on('propertyCreated', (newProperty) => {
        allProperties.push(newProperty); // 
        applyFilters(); // Takoj osveži prikaz in vključi nov marker 
    });

    // Filtriranje podatkov [cite: 44]
    function applyFilters() {
        const selectedType = document.getElementById('filterType').value; // [cite: 44]
        const maxPrice = parseFloat(priceFilter.value) || 1000000; // [cite: 45]

        const filtered = allProperties.filter(p => {
            const matchesType = selectedType === "" || p.type === selectedType; // [cite: 45]
            const matchesPrice = p.price <= maxPrice; // [cite: 45]
            return matchesType && matchesPrice; // [cite: 45]
        });
        updateUI(filtered); // [cite: 46]
    }

    // Osveževanje elementov na strani [cite: 46]
    function updateUI(data) {
        // 1. Očistimo stare markerje [cite: 46]
        propertyMarkers.clearLayers(); // [cite: 46]

        if (data.length === 0) {
            updateTypeChart([]); // [cite: 47]
            return; // 
        }

        // 2. Izris markerjev na zemljevidu 
        data.forEach(p => {
            if (p.location && p.location.location && p.location.location.coordinates) { // 
                const coords = p.location.location.coordinates; // [long, lat] 
               
                L.marker([coords[1], coords[0]]) // Leaflet potrebuje [lat, long] 
                 .bindPopup(`
                    <div style="font-family: Arial, sans-serif; min-width: 150px;">
                        <h6 style="margin:0 0 5px 0; text-transform: uppercase; color: #0d6efd;">${p.type === 'house' ? 'Hiša' : p.type === 'apartment' ? 'Stanovanje' : p.type === 'land' ? 'Zemljišče' : 'Kondominij'}</h6>
                        <b>Naslov:</b> ${p.location.address || ''}, ${p.location.city || ''}<br>
                        <b>Cena:</b> ${p.price.toLocaleString('sl-SI')} €<br>
                        <b>Velikost:</b> ${p.size} m²
                    </div>
                 `)
                 .addTo(propertyMarkers); // [cite: 50]
            }
        });

        // 3. Osvežitev grafov [cite: 52]
        updateTypeChart(data); // [cite: 52]
    }

    // Izris grafikona (Chart.js) [cite: 53]
    function updateTypeChart(data) {
        const ctx = document.getElementById('typeChart').getContext('2d'); // [cite: 53]
        if (window.myChart) window.myChart.destroy(); // [cite: 54]

        if (data.length === 0) {
            window.myChart = new Chart(ctx, {
                type: 'doughnut',
                data: { labels: ['Ni podatkov'], datasets: [{ data: [1], backgroundColor: ['#e0e0e0'] }] }, // [cite: 54]
                options: { plugins: { title: { display: true, text: 'Ni ustreznih podatkov' } } } // [cite: 55]
            });
            return; // [cite: 56]
        }

        const counts = data.reduce((acc, p) => {
            acc[p.type] = (acc[p.type] || 0) + 1; // [cite: 56]
            return acc; // [cite: 56]
        }, {});

        // Prevodi za lepši izpis na grafu
        const translation = { 'house': 'HIŠA', 'apartment': 'STANOVANJE', 'land': 'ZEMLJIŠČE', 'condominium': 'KONDOMINIJ' };

        window.myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: Object.keys(counts).map(t => translation[t] || t.toUpperCase()), // [cite: 57]
                datasets: [{
                    data: Object.values(counts), // [cite: 57]
                    backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0'] // [cite: 58]
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: { display: true, text: 'Porazdelitev nepremičnin po vrsti' } // [cite: 59]
                }
            }
        });
    }
</script>