<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card p-4 shadow-sm border-0" style="border-radius: 10px;">
                <h3 class="text-center mb-4">Registracija novega računa</h3>
                
                <form id="registerForm" autocomplete="off">
                    
                    <div class="mb-3">
                        <label for="name" class="form-label">Ime in priimek</label>
                        <input type="text" id="name" class="form-control" placeholder="Janez Novak" required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">E-poštni naslov</label>
                        <input type="email" id="email" class="form-control" autocomplete="new-username" placeholder="janez.novak@primer.si" required>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Geslo</label>
                        <input type="password" id="password" class="form-control" autocomplete="new-password" placeholder="Vnesite varno geslo" required>
                    </div>

                    <div class="mb-3">
                        <label for="type" class="form-label">Tip uporabnika</label>
                        <select id="type" class="form-select">
                            <option value="buyer">Kupec (Iskalec nepremičnin)</option>
                            <option value="owner">Lastnik / Agent (Oglaševalec)</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 mt-2">Registriraj se</button>
                </form>

                <p class="mt-4 text-center text-muted">
                    Že imate račun? <a href="/login" class="text-decoration-none">Prijava tukaj</a>
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('registerForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Zbiranje podatkov iz obrazca
        const userData = {
            name: document.getElementById('name').value,
            email: document.getElementById('email').value,
            password: document.getElementById('password').value,
            type: document.getElementById('type').value
        };

        try {
            // Pošiljanje podatkov na vaš Express API (UserRoutes.js)
            const response = await fetch('/users', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(userData)
            });

            const data = await response.json();

            if (response.ok) {
                alert('Registracija uspešna! Zdaj se lahko prijavite.');
                // Preusmeritev na prijavno stran
                window.location.href = '/login';
            } else {
                // Prikaz napake, ki jo vrne UserController (npr. če email že obstaja)
                alert(data.message || 'Napaka pri registraciji.');
            }
        } catch (error) {
            console.error('Napaka pri omrežni zahtevi:', error);
            alert('Prišlo je do napake pri povezavi s strežnikom.');
        }
    });
</script>